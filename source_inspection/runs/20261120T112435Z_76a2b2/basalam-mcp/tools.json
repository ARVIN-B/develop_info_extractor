    {
      "name": "bs_find_cheapest",
      "title": "Find cheapest products",
      "description": "List the cheapest in-stock offers for a query, cheapest first, prices in Toman.\n\nDrops out-of-stock items. Raise min_price if results are still accessories; narrow with category_id.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Persian words, e.g. 'عسل طبیعی'.",
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "min_price": {
            "default": 5000,
            "description": "Lowest price in Toman; 5000 hides filler listings.",
            "minimum": 0,
            "type": "integer"
          },
          "max_price": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Toman, e.g. 500000."
          },
          "category_id": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Id from bs_categories, any level."
          },
          "free_shipping": {
            "default": false,
            "description": "Only free shipping.",
            "type": "boolean"
          },
          "top_vendors": {
            "default": false,
            "description": "Only top-rated shops.",
            "type": "boolean"
          },
          "rating_min": {
            "default": 0,
            "description": "Min rating; above 0 drops unrated.",
            "maximum": 5,
            "minimum": 0,
            "type": "number"
          },
          "limit": {
            "default": 10,
            "description": "Offers to return.",
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
