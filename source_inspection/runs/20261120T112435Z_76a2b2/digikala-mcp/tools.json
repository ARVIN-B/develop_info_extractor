    {
      "name": "dk_search",
      "title": "Search products",
      "description": "Search products by name: price (Toman), discount, seller, rating, 20 per page.\n\nEach product has `match` ('all', 'some' + `missing_words`, 'none'); prefer 'all'.\nFilter ids: dk_filters(query=...).",
