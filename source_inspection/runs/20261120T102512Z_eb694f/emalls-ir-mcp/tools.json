{
  "evidence_status": "verified_tool_schema",
  "tools": [
    {
      "name": "em_search",
      "title": "Search products and price lists",
      "description": "Search Emalls (Iranian price comparison) for products, with price range, category, brand, spec and sort filters.\n\nUse it first to find a product `id`; each row has the lowest price in Toman and shop count. Unknown category:\nem_categories. Brand/spec filters: em_filters first. Then em_product, em_offers, em_compare or em_price_history.",
      "input_schema": {
        "properties": {
          "query": {
            "default": "",
            "description": "Product words, Persian or English, e.g. گوشی سامسونگ A17. Empty with category_id browses it.",
            "maxLength": 200,
            "type": "string"
          },
          "category_id": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Category id from em_categories, e.g. 39 phones."
          },
          "min_price": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Toman."
          },
          "max_price": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Toman."
          },
          "sort": {
            "default": "popular",
            "description": "cheapest also lists accessories: pair with min_price or category_id.",
            "enum": [
              "popular",
              "cheapest",
              "expensive",
              "newest"
            ],
            "type": "string"
          },
          "in_stock": {
            "default": true,
            "description": "Only products some shop has in stock.",
            "type": "boolean"
          },
          "page": {
            "default": 1,
            "description": "40 products per page.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "limit": {
            "default": 20,
            "description": "Max products from the page.",
            "maximum": 40,
            "minimum": 1,
            "type": "integer"
          },
          "brand_id": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Brand id from em_filters."
          },
          "attributes": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "maxItems": 10,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Option ids from em_filters; one per spec group, all must match."
          }
        },
        "type": "object"
      },
      "execution": null,
      "output_schema": null,
      "icons": null,
      "annotations": {
        "title": null,
        "read_only_hint": true,
        "destructive_hint": false,
        "idempotent_hint": true,
        "open_world_hint": true
      },
      "meta": null
    },
    {
      "name": "em_categories",
      "title": "Find product categories",
      "description": "Find Emalls category ids by words, or browse the category tree (top level, then children of a category id).\n\nUse it to get `category_id` for em_search. With `query`: matching categories plus popular search phrases.\nWithout: top-level categories; parent_id lists sub-categories and brand shortcuts.",
      "input_schema": {
        "properties": {
          "query": {
            "default": "",
            "description": "Words, e.g. لپ تاپ. Empty browses the tree.",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Sub-categories of this id. Empty: top level."
          }
        },
        "type": "object"
