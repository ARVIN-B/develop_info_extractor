    {
      "name": "rs_search_companies",
      "title": "Search companies",
      "description": "Search Iranian companies by name or activity with filters; returns national ids for rs_company.\n\nFilters combine freely. Next: rs_company(company_id).",
      "inputSchema": {
        "properties": {
          "query": {
            "default": "",
            "description": "Persian name, brand or activity words, e.g. 'دیجی کالا'. Empty = filters only.",
            "type": "string"
          },
          "province": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Persian province name, e.g. 'تهران'."
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Persian city name, e.g. 'مشهد'."
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "active",
                  "tax_inactive",
                  "liquidated",
                  "incomplete_data",
                  "revoked",
                  "license_ended",
                  "inactive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "company_type": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Legal form id (rs_options 'company_types'); 5 = سهامی خاص, 6 = با مسئولیت محدود, 3 = تعاونی."
          },
          "size": {
            "anyOf": [
              {
                "enum": [
                  "xs",
                  "s",
                  "m",
                  "l",
                  "xl"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Headcount class, xs smallest .. xl largest."
          },
          "min_capital": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Minimum capital, Rial."
          },
          "max_capital": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Maximum capital, Rial."
          },
          "founded_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Registered on/after; '1400/01/01' or '2021-03-21'."
          },
          "founded_before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Registered on/before, same formats."
          },
          "license_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "License id from rs_options('licenses')."
          },
          "product_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Product category slug (rs_options 'categories' or a product's category_slug)."
          },
          "has_brand": {
            "default": false,
            "description": "Owns a trademark.",
            "type": "boolean"
          },
          "has_subsidiary": {
            "default": false,
            "description": "Has subsidiaries.",
            "type": "boolean"
          },
          "has_contract": {
            "default": false,
            "description": "Has government contracts.",
            "type": "boolean"
          },
          "sort": {
            "default": "relevance",
            "enum": [
              "relevance",
              "most_viewed",
              "newest",
              "oldest",
              "lowest_capital",
              "highest_capital"
            ],
            "type": "string"
          },
          "page": {
            "default": 1,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "page_size": {
            "default": 20,
            "maximum": 60,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
