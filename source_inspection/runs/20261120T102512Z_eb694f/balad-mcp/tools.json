    {
      "name": "bl_route",
      "title": "Driving route with live traffic",
      "description": "Get driving routes in Iran with distance, travel time in current traffic, tolls, roads and traffic-zone warnings.\n\nUp to 3 routes, suggested first; `notes` are the site's labels (delay, toll in Toman); `traffic_plan` appears\nwhen a route enters a restricted zone (طرح ترافیک, زوج و فرد); `legs` with `stops`. Driving only. Get\ncoordinates from bl_search. 'No route': a point is outside Iran or off the road network.",
      "input_schema": {
        "properties": {
          "from_lat": {
            "description": "Latitude, e.g. 35.7448.",
            "maximum": 40.5,
            "minimum": 24,
            "type": "number"
          },
          "from_lng": {
            "description": "Longitude, e.g. 51.3753.",
            "maximum": 64,
            "minimum": 43,
            "type": "number"
          },
          "to_lat": {
            "description": "Latitude, e.g. 35.7448.",
            "maximum": 40.5,
            "minimum": 24,
            "type": "number"
          },
          "to_lng": {
            "description": "Longitude, e.g. 51.3753.",
            "maximum": 64,
            "minimum": 43,
            "type": "number"
          },
          "stops": {
            "default": [],
            "description": "Stops in order, each \"lat,lng\" (max 3).",
            "items": {
              "pattern": "^\\s*-?\\d+(\\.\\d+)?\\s*,\\s*-?\\d+(\\.\\d+)?\\s*$",
              "type": "string"
            },
            "maxItems": 3,
            "type": "array"
          },
          "steps": {
            "default": false,
            "description": "Include turn-by-turn steps.",
            "type": "boolean"
          }
        },
        "required": [
          "from_lat",
          "from_lng",
          "to_lat",
          "to_lng"
        ],
        "type": "object"
      },
      "execution": null,
