{
  "evidence_status": "verified_tool_schema",
  "tools": [
    {
      "name": "bl_search",
      "title": "Search places and addresses",
      "description": "Search Balad (Iranian map) for places, streets, neighbourhoods and cities by name, with coordinates and address.\n\nAlso geocodes addresses and city names. Pass lat/lng when searching outside Tehran (nearer results rank\nfirst). `type` is poi (pass its `id` to bl_place), road, city, region or category (its `category` slug goes\nto bl_nearby). For all places of one kind use bl_nearby. Empty: try a shorter or Persian query.",
      "input_schema": {
        "properties": {
          "query": {
            "description": "Place name, street, address, neighbourhood or city, e.g. برج میلاد.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "lat": {
            "anyOf": [
              {
                "maximum": 40.5,
                "minimum": 24,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Latitude to search around. Default: Tehran."
          },
          "lng": {
            "anyOf": [
              {
                "maximum": 64,
                "minimum": 43,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Longitude to search around. Default: Tehran."
          },
          "limit": {
            "default": 10,
            "description": "Max results (1-20).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "execution": null,
      "output_schema": null,
      "icons": null,
      "annotations": {
        "title": null,
        "read_only_hint": true,
        "destructive_hint": false,
        "idempotent_hint": true,
        "open_world_hint": true
      },
      "meta": null
    },
    {
      "name": "bl_nearby",
      "title": "Nearby places by category",
      "description": "List places of one kind (pharmacy, restaurant, gas station...) around a point, with address, phone and rating.\n\nBalad's own order, each with straight-line `distance_km`. Free text naming a category (پیتزا) lists that\nwhole category (`category` says which). Get the point from bl_search. For driving time use\nbl_nearest_by_drive; for places on a trip bl_along_route; for hours and reviews bl_place with `id`. Empty:\nwiden radius_km or drop filters.",
      "input_schema": {
        "properties": {
          "what": {
            "description": "Category slug from bl_categories (e.g. pharmacy, gas-station) or free text (e.g. پیتزا).",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "lat": {
            "description": "Latitude, e.g. 35.7448.",
            "maximum": 40.5,
            "minimum": 24,
            "type": "number"
          },
          "lng": {
            "description": "Longitude, e.g. 51.3753.",
            "maximum": 64,
            "minimum": 43,
            "type": "number"
          },
          "radius_km": {
            "default": 1,
            "description": "Box half-width in km (0.2-20).",
            "maximum": 20,
            "minimum": 0.2,
            "type": "number"
          },
          "limit": {
            "default": 10,
            "description": "Max places (1-40).",
            "maximum": 40,
            "minimum": 1,
            "type": "integer"
          },
          "open_now": {
            "default": false,
            "description": "Only places open now.",
            "type": "boolean"
          },
          "min_rating": {
            "anyOf": [
              {
                "enum": [
                  "3",
                  "4",
                  "4.5"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only places rated above this."
          },
          "sort": {
            "default": "relevance",
            "description": "rating = best first, popular = most visited.",
            "enum": [
              "relevance",
              "rating",
              "popular"
            ],
            "type": "string"
          },
          "with_phone": {
            "default": false,
            "description": "Only places with a phone number.",
            "type": "boolean"
          },
          "with_photos": {
            "default": false,
            "description": "Only places with photos.",
            "type": "boolean"
          },
          "price": {
            "anyOf": [
              {
                "enum": [
                  "cheap",
                  "moderate",
                  "expensive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Restaurants and cafes only."
          }
        },
        "required": [
          "what",
          "lat",
          "lng"
        ],
        "type": "object"
      },
      "execution": null,
      "output_schema": null,
      "icons": null,
      "annotations": {
        "title": null,
        "read_only_hint": true,
        "destructive_hint": false,
        "idempotent_hint": true,
        "open_world_hint": true
      },
      "meta": null
    },
    {
      "name": "bl_place",
      "title": "Place details",
      "description": "Get one place's full details from Balad: address, phones, hours, open now, rating, amenities, photos, reviews.\n\n`hours` maps each weekday (شنبه..جمعه) to its hours; `menu` is the menu link. More reviews: bl_reviews;\ndirections: bl_route with its lat/lng.",
      "input_schema": {
        "properties": {
          "id": {
            "description": "Place id from bl_search or bl_nearby.",
            "pattern": "^[A-Za-z0-9]{6,32}$",
            "type": "string"
          },
          "reviews": {
            "default": 3,
            "description": "Recent reviews to include (0-10).",
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "photos": {
            "default": 3,
            "description": "Photo URLs to include (0-20).",
            "maximum": 20,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "execution": null,
