{
  "evidence_status": "verified_tool_schema",
  "tools": [
    {
      "name": "tb_search",
      "title": "Search products",
      "description": "Search Torob for products; each card has the cheapest shop price (Toman) and the shop count.\n\nWeak matches set `low_confidence` and `unmatched_terms`; `spellcheck` / `suggested_queries` help rephrase.\n`price_span` is the span of the unfiltered result.",
      "inputSchema": {
        "properties": {
          "query": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Persian or Finglish text, e.g. 'گوشی آیفون 13'. Optional with category."
          },
          "sort": {
            "default": "popular",
            "description": "most_sellers = most shops.",
            "enum": [
              "popular",
              "cheapest",
              "priciest",
              "newest",
              "most_sellers"
            ],
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "maximum": 10000000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Category id, e.g. 94."
          },
          "brand": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Brand id or name ('Apple', 'اپل'); needs query or category."
          },
          "min_price": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Toman."
          },
          "max_price": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Toman."
          },
          "available_only": {
            "default": false,
            "type": "boolean"
          },
          "condition": {
            "default": "any",
            "description": "used = کارکرده / stock.",
            "enum": [
              "any",
              "new",
              "used"
            ],
            "type": "string"
          },
          "in_person": {
            "default": false,
            "description": "Only products with an in-person shop.",
            "type": "boolean"
          },
          "installment": {
            "default": false,
            "description": "Only installment (Torob Pay) products.",
            "type": "boolean"
          },
          "city": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "City id or name; effect unverified, use tb_sellers(city=) for local offers."
          },
          "filters": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Attribute filters {slug: value} from tb_filters, e.g. {'storage': '256 gb'}."
          },
          "page": {
            "default": 0,
            "description": "0-based.",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "output": {
            "default": "json",
            "enum": [
              "json",
              "csv"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "execution": null,
      "outputSchema": null,
      "icons": null,
      "annotations": {
        "title": null,
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
