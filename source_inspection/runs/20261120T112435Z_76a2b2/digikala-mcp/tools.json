            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "sort": {
            "default": "relevance",
            "enum": [
              "relevance",
              "cheapest",
              "most_expensive",
              "best_selling",
              "most_viewed",
              "newest",
              "fastest_delivery",
              "buyers_pick"
            ],
            "type": "string"
          },
          "min_price": {
            "default": null,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_price": {
            "default": null,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "brand_ids": {
            "default": null,
            "description": "Brand ids (dk_product brand_id), e.g. [18] Samsung.",
            "items": {
              "type": "integer"
            },
            "maxItems": 5,
            "type": [
              "array",
              "null"
            ]
          },
          "attributes": {
            "default": null,
            "description": "{attribute id: [value ids]} from dk_filters, e.g. {2226: [19239]}. Values OR, attributes AND.",
            "additionalProperties": {
              "items": {
                "type": "integer"
              },
              "maxItems": 20,
              "type": "array"
            },
            "maxProperties": 10,
            "type": [
              "object",
              "null"
            ]
          },
          "colors": {
            "default": null,
            "description": "Color ids from dk_filters.",
