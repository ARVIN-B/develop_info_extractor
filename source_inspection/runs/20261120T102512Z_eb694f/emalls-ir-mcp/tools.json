    {
      "name": "em_offers",
      "title": "Shop offers for a product",
      "description": "List the shops selling one Emalls product with price, city, shop rating, warranty and buy link, cheapest first.\n\nUse it to find the cheapest, most trusted or nearest offer. `buy_url` is a click-through link: open it only\nif the user wants to buy. `total_shops` = shops with a live price before filters.",
      "input_schema": {
        "properties": {
          "product_id": {
            "description": "Product id from em_search.",
            "maximum": 2000000000,
            "minimum": 1,
            "type": "integer"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "City or province in Persian, e.g. تهران."
          },
          "established_only": {
            "default": false,
            "description": "Only established shops (با‌سابقه).",
            "type": "boolean"
          },
          "pickup_only": {
            "default": false,
            "description": "Only shops offering in-person purchase (خرید حضوری).",
            "type": "boolean"
          },
          "sort": {
            "default": "price",
            "description": "price: cheapest first; rating: best shops first.",
            "enum": [
              "price",
              "rating"
            ],
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "Max offers.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          }
