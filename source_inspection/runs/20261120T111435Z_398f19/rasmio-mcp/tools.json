  "tools": [
    {
      "name": "rs_company",
      "title": "Company profile",
      "description": "Registry profile of one Iranian company: basics, board and CEO, shareholders, licenses, capital history, ads.\n\nsections: people=board/officers/auditors, ownership=shareholders/stock, licenses=licenses/brands/patents,\nfinance=capital changes/contracts/statements, ads. Board rows give person_id (rs_person) and ad_id (rs_ad). Anonymous quota is a few profiles per IP every few\ndays; the error says when it is reached.",
      "inputSchema": {
        "properties": {
          "company_id": {
            "description": "11-digit national id (شناسه ملی) from rs_search_companies, e.g. '10100360794'.",
            "type": "string"
          },
          "sections": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "people",
                    "ownership",
                    "licenses",
                    "finance",
                    "ads"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Parts besides the basics; empty = all."
          },
          "max_rows": {
            "default": 10,
            "description": "Rows per table.",
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "company_id"
        ],
        "type": "object"
      },
      "execution": null,
      "outputSchema": null,
      "icons": null,
      "annotations": {
        "title": null,
        "readOnlyHint": true,
