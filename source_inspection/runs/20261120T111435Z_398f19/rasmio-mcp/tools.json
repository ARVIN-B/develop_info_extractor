    {
      "name": "rs_search",
      "title": "Search people, products, brands or patents",
      "description": "Search people (board members, managers), products, registered brands or patents and industrial designs.\n\nGives person_id (rs_person), product_id (rs_product) or ip_id (rs_ip). For companies use rs_search_companies.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Persian words (Latin for brands), e.g. 'روغن موتور', 'Samsung'.",
            "type": "string"
          },
          "kind": {
            "default": "people",
            "description": "'everything' mixes companies, people, brands, products.",
            "enum": [
              "people",
              "products",
              "brands",
              "patents",
              "everything"
            ],
            "type": "string"
          },
          "product_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "products only: slug from rs_options('categories')."
          },
          "brand_class": {
            "anyOf": [
              {
                "maximum": 45,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "brands only: Nice class, 9 = electronics, 30 = foods."
          },
          "mark_type": {
            "anyOf": [
              {
                "enum": [
                  "image",
                  "text",
                  "combined"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "brands only."
          },
          "patent_kind": {
            "anyOf": [
              {
                "enum": [
                  "invention",
                  "industrial_design"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "patents only."
          },
          "page": {
            "default": 1,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "page_size": {
            "default": 20,
            "maximum": 60,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
