  "tools": [
    {
      "name": "bs_search",
      "title": "Search products",
      "description": "Search Basalam products and return a page of cards with prices in Toman.\n\nTo rank by real price use bs_find_cheapest. Link: https://basalam.com/p/<id>; pages can repeat a few products.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Persian words, e.g. 'عسل طبیعی'.",
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "sort": {
            "default": "relevance",
            "description": "Order.",
            "enum": [
              "relevance",
              "bestselling",
              "cheapest",
              "expensive",
              "newest"
            ],
            "type": "string"
          },
          "min_price": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Toman, e.g. 100000."
          },
          "max_price": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Toman, e.g. 500000."
          },
          "category_id": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Id from bs_categories, any level."
          },
          "free_shipping": {
            "default": false,
            "description": "Only free shipping.",
            "type": "boolean"
          },
          "has_discount": {
            "default": false,
            "description": "Only discounted.",
            "type": "boolean"
          },
          "top_vendors": {
            "default": false,
            "description": "Only top-rated shops.",
            "type": "boolean"
          },
          "installments": {
            "default": false,
            "description": "Only installment-payable.",
            "type": "boolean"
          },
          "page": {
            "default": 1,
            "description": "Page number, 1-based.",
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "limit": {
            "default": 12,
            "description": "Products per page.",
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "execution": null,
      "outputSchema": null,
